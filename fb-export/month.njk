---
layout: layouts/base.njk
pagination:
  data: collections.postsByMonth
  size: 1
  alias: monthData
permalink: "fb-export/{{ monthData.year }}/{{ monthData.month }}/index.html"
eleventyComputed:
  title: "Facebook Archive - {{ monthData.year }}-{{ monthData.month }}"
---

<div data-pagefind-ignore="all">
  <h1>Posts for {{ monthData.year }}-{{ monthData.month }}</h1>

  {% for post in monthData.posts %}
    <article class="fb-post">
      <h2><a href="{{ post.url }}">{{ post.data.author or "Post" }}</a></h2>
      <p class="fb-date">{{ post.data.date }}</p>
      <div class="fb-excerpt">
        {{ post.templateContent | striptags | truncate(500) }}
      </div>
      <p><a href="{{ post.url }}">Read full post →</a></p>
    </article>
    <hr>
  {% endfor %}

  <!-- AUTOMATIC MONTH NAVIGATION -->
  <nav class="post-navigation">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="nav-btn">← Newer Month</a>
    {% endif %}

    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="nav-btn">Older Month →</a>
    {% endif %}
  </nav>
</div>
