<!DOCTYPE html>
<html lang="{% if lang and lang != 'unknown' %}{{ lang }}{% else %}en{% endif %}">>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="nOVhyCaoXpjBXXPo-CqrEgfb2rKBCeNpaKtmZ-xNaeM">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HHVG075GJS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HHVG075GJS');
  </script>

  <script>
    (function() {
      const size = localStorage.getItem('user-font-size');
      const font = localStorage.getItem('user-font-family');
      const lh = localStorage.getItem('user-line-height');
      const root = document.documentElement;
      if (size) root.style.setProperty('--font-size', size + 'rem');
      if (font) root.style.setProperty('--font-family', font);
      if (lh) root.style.setProperty('--line-height', lh);
    })();
  </script>

  <title>{{ title }}</title>
  <link rel="stylesheet" href="/assets/bundle.css">
  <script type="module" src="/assets/bundle.js"></script>
</head>
<body>

  {% include "header/header.njk" %}

  <main data-pagefind-body>
    <div class="page-container content">

      <!-- Universal URL Breadcrumb -->
      {% include "components/breadcrumb.njk" %}

      <article class="fb-post">
        <!-- Post Header -->
        <header class="fb-post__header">
          {% if author %}
            <h1 class="fb-post__author">{{ author }}</h1>
          {% endif %}
          <time class="fb-post__date" datetime="{{ date }}">{{ date }}</time>
        </header>

        <!-- Main Body & Shared Content -->
        <div class="fb-post__body">
          {{ content | safe }}
        </div>
      </article>

      <!-- PREVIOUS / NEXT POST NAVIGATION -->
      {% set previousPost = collections.facebook | getPreviousCollectionItem(page) %}
      {% set nextPost = collections.facebook | getNextCollectionItem(page) %}

      {% if previousPost or nextPost %}
        <hr class="fb-divider">
        <nav class="post-navigation" aria-label="Post pagination">
          {% if previousPost %}
            <a href="{{ previousPost.url }}" class="nav-btn prev-btn">
              ← Previous Post
            </a>
          {% else %}
            <div></div>
          {% endif %}

          {% if nextPost %}
            <a href="{{ nextPost.url }}" class="nav-btn next-btn">
              Next Post →
            </a>
          {% endif %}
        </nav>
      {% endif %}

      <!-- Metadata Box -->
      <section class="fb-metadata">
        <h2>Post Information</h2>
        {% if author %}
          <p><strong>Author:</strong> {{ author }}</p>
        {% endif %}

        {% if group %}
          <p><strong>Group:</strong> {{ group }}</p>
        {% endif %}

        <p><strong>Date:</strong> {{ date }}</p>

        {% if facebook %}
          <p>
            <strong>Original:</strong>
            <a href="{{ facebook }}" target="_blank" rel="noopener noreferrer">
              View on Facebook ↗
            </a>
          </p>
        {% endif %}
      </section>

      <!-- Pagefind search filters -->
      <div hidden data-pagefind-filter="author" show-empty="false">{{ author }}</div>
      <div hidden data-pagefind-filter="group" show-empty="false">{{ group }}</div>

    </div>
  </main>

  {% include "footer/footer.html" %}

</body>
</html>
