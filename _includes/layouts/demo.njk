---
layout: layouts/base.njk
title: EHS Demo Events Log
---

<h1>EHS Demo Events Log</h1>

<div class="demo-timeline">
  
  {# This loop automatically grabs ehs_demo.json, sorts by date, and reverses for newest-first #}
  {% for entry in ehs_demo | sort(attribute="date") | reverse %}
    
    <article class="demo-event" style="margin-bottom: 2rem; padding: 1rem; border: 1px solid #e2e8f0; border-radius: 8px;">
      <h2>{{ entry.date }} - {{ entry.location }}</h2>
      
      <ul>
        <li><strong>Status:</strong> {{ entry.status | default("Unknown", true) }}</li>
        {% if entry.organisers %}
          <li><strong>Organisers:</strong> {{ entry.organisers }}</li>
        {% endif %}
      </ul>

      {% if entry.note %}
        <p><strong>Note:</strong> {{ entry.note }}</p>
      {% endif %}

      {% if entry.links | length %}
        <h3>Links & References</h3>
        <ul>
          {% for link in entry.links %}
            <li>
              <a href="{{ link.url }}" target="_blank" rel="noopener">View Source</a>
              {% if link.comment %} - {{ link.comment }}{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </article>

  {% endfor %}
</div>

