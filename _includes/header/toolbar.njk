<!-- Pagefind Container -->
<div id="search" class="search-container"></div>

<!-- Typography Toolbar -->
<div class="reading-toolbar" aria-label="Reading options">

  <!-- Font Family Selector (language-aware) -->
  {% if lang == 'hi' %}
    {% set fontLabel = 'फ़ॉन्ट शैली' %}
    {% set fontOptions = [
      { value: "'Noto Sans Devanagari', 'Nirmala UI', 'Mangal', system-ui, -apple-system, sans-serif", label: 'सैन्स-सेरिफ़' },
      { value: "'Noto Serif Devanagari', 'Kohinoor Devanagari', 'Devanagari Sangam MN', serif", label: 'सेरिफ़' },
      { value: "'Noto Sans Mono Devanagari', monospace, sans-serif", label: 'मोनोस्पेस' },
      { value: "'Kalam', 'Noto Serif Devanagari', serif", label: 'कर्सिव' }
    ] %}
  {% else %}
    {% set fontLabel = 'Font Style' %}
    {% set fontOptions = [
      { value: "system-ui, -apple-system, sans-serif", label: 'Sans-Serif' },
      { value: "Georgia, serif", label: 'Serif' },
      { value: "'Courier New', monospace", label: 'Monospace' },
      { value: "'Times New Roman', Times, serif", label: 'T.N. Roman' },
      { value: "cursive", label: 'Cursive' }
    ] %}
  {% endif %}
  <div class="toolbar-group">
    <label for="font-family" class="sr-only">{{ fontLabel }}</label>
    <select id="font-family" class="toolbar-select" title="{{ fontLabel }}" data-lang="{{ lang or 'en' }}">
      {% for option in fontOptions %}
        <option value="{{ option.value }}" style="font-family: {{ option.value }};">{{ option.label }}</option>
      {% endfor %}
    </select>
  </div>

  <span class="toolbar-divider" aria-hidden="true"></span>

  <!-- Font Size Controls -->
  <div class="toolbar-group">
    <span class="toolbar-label" id="size-label"></span>
    <div class="btn-group" role="group" aria-labelledby="size-label">
      <button type="button" id="size-down" title="Decrease font size" aria-label="Decrease font size">A−</button>
      <button type="button" id="size-reset" title="Reset font size" aria-label="Reset font size">100%</button>
      <button type="button" id="size-up" title="Increase font size" aria-label="Increase font size">A+</button>
    </div>
  </div>

  <span class="toolbar-divider" aria-hidden="true"></span>

  <!-- Boldness Controls -->
  <div class="toolbar-group">
    <span class="toolbar-label" id="weight-label"></span>
    <div class="btn-group" role="group" aria-labelledby="weight-label">
      <button type="button" id="weight-down" title="Decrease boldness" aria-label="Decrease boldness">B−</button>
      <button type="button" id="weight-reset" title="Reset boldness" aria-label="Reset boldness">Normal</button>
      <button type="button" id="weight-up" title="Increase boldness" aria-label="Increase boldness">B+</button>
    </div>
  </div>

  <span class="toolbar-divider" aria-hidden="true"></span>

  <!-- Line Spacing Toggles -->
  <div class="toolbar-group">
    <span class="toolbar-label" id="spacing-label"></span>
    <div class="btn-group" role="group" aria-labelledby="spacing-label">
      <button type="button" class="spacing-btn" data-lh="1.3" title="Compact spacing" aria-label="Compact line spacing">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button type="button" class="spacing-btn active" data-lh="1.6" title="Normal spacing" aria-label="Normal line spacing">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16M4 12h16M4 20h16"/></svg>
      </button>
      <button type="button" class="spacing-btn" data-lh="1.9" title="Relaxed spacing" aria-label="Relaxed line spacing">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2h16M4 12h16M4 22h16"/></svg>
      </button>
    </div>
  </div>

  <span class="toolbar-divider" aria-hidden="true"></span>

  <!-- Language Switcher -->
  <div class="toolbar-group">
    {% include "header/lang-switcher.njk" %}
  </div>

</div>
