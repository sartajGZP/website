<!-- Typography FOUC prevention: apply saved prefs before first paint -->
<script>
  (function() {
    const root = document.documentElement;
    const lang = root.lang || 'en';
    const size = localStorage.getItem('user-font-size');
    const lh = localStorage.getItem('user-line-height');
    // Font is stored per language; fall back to the legacy global key once
    // (toolbar.js migrates it to the per-language key on load).
    const font = localStorage.getItem('user-font-family-' + lang)
      || localStorage.getItem('user-font-family');

    if (size) root.style.setProperty('--font-size', size + 'rem');
    if (lh) root.style.setProperty('--line-height', lh);
    if (font) {
      root.style.setProperty('--font-family', font);
      // Lazy-load the self-hosted Kalam webfont: only when it is in use.
      if (font.indexOf('Kalam') !== -1 && !document.querySelector('link[data-font="kalam"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/assets/fonts/kalam.css';
        link.setAttribute('data-font', 'kalam');
        document.head.appendChild(link);
      }
    }
  })();
</script>
