---
title: My Blogs on Tech Addiction and Tech
layout: layouts/base.njk
eleventyNavigation:
  key: blog
---

<h1>Blog</h1>
{% set posts = collections.blog | reverse %}

{% for post in posts %}

  <article class="blog-post">
    <h2>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    {% if post.data.description %}
  <div class="gist">
    {{ post.data.description }}
  </div>
{% endif %}

  </article>  <hr>
{% endfor %}
